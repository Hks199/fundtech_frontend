# Development requests are proxied through Vite to this backend.
API_PROXY_TARGET=https://fundtech.niakylie.com
# Vercel: leave empty to use the backend rewrites in vercel.json.
# Other hosts: set the public HTTPS backend origin without /api, or configure a proxy.
VITE_API_BASE_URL=
# Display currency only; the backend does not specify a currency.
VITE_CURRENCY=INR
